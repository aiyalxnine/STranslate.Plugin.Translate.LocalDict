<UserControl
    x:Class="STranslate.Plugin.Translate.LocalDict.View.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ikw="http://schemas.inkore.net/lib/ui/wpf"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
    xmlns:vm="clr-namespace:STranslate.Plugin.Translate.LocalDict.ViewModel"
    x:Name="Root"
    d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel}"
    d:DesignWidth="700"
    mc:Ignorable="d">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </UserControl.Resources>

    <ikw:SimpleStackPanel Spacing="4">
        <!--  词库列表  -->
        <ui:SettingsCard
            Description="{DynamicResource STranslate_Plugin_Translate_LocalDict_DictionariesDesc}"
            Header="{DynamicResource STranslate_Plugin_Translate_LocalDict_Dictionaries}">
            <ui:SettingsCard.HeaderIcon>
                <ui:FontIcon Icon="{x:Static ui:FluentSystemIcons.Library_20_Regular}" />
            </ui:SettingsCard.HeaderIcon>
            <Button Command="{Binding AddCommand}">
                <ikw:SimpleStackPanel Orientation="Horizontal" Spacing="6">
                    <ui:FontIcon FontSize="14" Icon="{x:Static ui:FluentSystemIcons.Add_20_Regular}" />
                    <TextBlock Text="{DynamicResource STranslate_Plugin_Translate_LocalDict_Add}" />
                </ikw:SimpleStackPanel>
            </Button>
        </ui:SettingsCard>

        <TextBlock
            Margin="16,4"
            Opacity="0.7"
            Text="{DynamicResource STranslate_Plugin_Translate_LocalDict_Empty}"
            TextWrapping="Wrap"
            Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />

        <ItemsControl ItemsSource="{Binding Dictionaries}">
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:DictionaryItemViewModel}">
                    <ui:SettingsCard Margin="24,0,0,4">
                        <ui:SettingsCard.Header>
                            <TextBlock FontWeight="SemiBold" Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                        </ui:SettingsCard.Header>
                        <ui:SettingsCard.Description>
                            <ikw:SimpleStackPanel Spacing="2">
                                <TextBlock
                                    Opacity="0.7"
                                    Text="{Binding Path}"
                                    TextWrapping="Wrap"
                                    ToolTip="{Binding Path}" />
                                <TextBlock Text="{Binding Status}" TextWrapping="Wrap">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasError}" Value="True">
                                                    <Setter Property="Foreground" Value="#D13438" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </ikw:SimpleStackPanel>
                        </ui:SettingsCard.Description>
                        <ikw:SimpleStackPanel Orientation="Horizontal" Spacing="4">
                            <ui:ToggleSwitch
                                MinWidth="0"
                                IsOn="{Binding Enabled}"
                                OffContent=""
                                OnContent=""
                                ToolTip="{DynamicResource STranslate_Plugin_Translate_LocalDict_Enabled}" />
                            <Button
                                Command="{Binding DataContext.MoveUpCommand, ElementName=Root}"
                                CommandParameter="{Binding}"
                                ToolTip="{DynamicResource STranslate_Plugin_Translate_LocalDict_MoveUp}">
                                <ui:FontIcon FontSize="14" Icon="{x:Static ui:FluentSystemIcons.ArrowUp_20_Regular}" />
                            </Button>
                            <Button
                                Command="{Binding DataContext.MoveDownCommand, ElementName=Root}"
                                CommandParameter="{Binding}"
                                ToolTip="{DynamicResource STranslate_Plugin_Translate_LocalDict_MoveDown}">
                                <ui:FontIcon FontSize="14" Icon="{x:Static ui:FluentSystemIcons.ArrowDown_20_Regular}" />
                            </Button>
                            <Button
                                Command="{Binding DataContext.RemoveCommand, ElementName=Root}"
                                CommandParameter="{Binding}"
                                ToolTip="{DynamicResource STranslate_Plugin_Translate_LocalDict_Remove}">
                                <ui:FontIcon FontSize="14" Icon="{x:Static ui:FluentSystemIcons.Delete_20_Regular}" />
                            </Button>
                        </ikw:SimpleStackPanel>
                    </ui:SettingsCard>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!--  显示选项  -->
        <ui:SettingsCard
            Margin="0,8,0,0"
            Description="{DynamicResource STranslate_Plugin_Translate_LocalDict_ShowEnglishDesc}"
            Header="{DynamicResource STranslate_Plugin_Translate_LocalDict_ShowEnglish}">
            <ui:SettingsCard.HeaderIcon>
                <ui:FontIcon Icon="{x:Static ui:FluentSystemIcons.BookOpen_20_Regular}" />
            </ui:SettingsCard.HeaderIcon>
            <ui:ToggleSwitch IsOn="{Binding ShowEnglishDefinition}" OffContent="{DynamicResource STranslate_Plugin_Translate_LocalDict_Off}" OnContent="{DynamicResource STranslate_Plugin_Translate_LocalDict_On}" />
        </ui:SettingsCard>

        <ui:SettingsCard Header="{DynamicResource STranslate_Plugin_Translate_LocalDict_ShowPhrasalVerbs}">
            <ui:SettingsCard.HeaderIcon>
                <ui:FontIcon Icon="{x:Static ui:FluentSystemIcons.Book_20_Regular}" />
            </ui:SettingsCard.HeaderIcon>
            <ui:ToggleSwitch IsOn="{Binding ShowPhrasalVerbs}" OffContent="{DynamicResource STranslate_Plugin_Translate_LocalDict_Off}" OnContent="{DynamicResource STranslate_Plugin_Translate_LocalDict_On}" />
        </ui:SettingsCard>

        <ui:SettingsCard
            Description="{DynamicResource STranslate_Plugin_Translate_LocalDict_MaxExamplesDesc}"
            Header="{DynamicResource STranslate_Plugin_Translate_LocalDict_MaxExamples}">
            <ui:SettingsCard.HeaderIcon>
                <ui:FontIcon Icon="{x:Static ui:FluentSystemIcons.Speaker2_20_Regular}" />
            </ui:SettingsCard.HeaderIcon>
            <ComboBox
                MinWidth="90"
                ItemsSource="{Binding ExampleCountOptions}"
                SelectedItem="{Binding MaxExamples}" />
        </ui:SettingsCard>

        <ui:SettingsCard Header="{DynamicResource STranslate_Plugin_Translate_LocalDict_About}">
            <ui:SettingsCard.HeaderIcon>
                <ui:FontIcon Icon="{x:Static ui:FluentSystemIcons.Info_20_Regular}" />
            </ui:SettingsCard.HeaderIcon>
            <ui:SettingsCard.Description>
                <TextBlock Text="{DynamicResource STranslate_Plugin_Translate_LocalDict_AboutContent}" TextWrapping="Wrap" />
            </ui:SettingsCard.Description>
        </ui:SettingsCard>
    </ikw:SimpleStackPanel>
</UserControl>
