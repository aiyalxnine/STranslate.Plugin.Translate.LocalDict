<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <sys:String x:Key="STranslate_Plugin_Translate_LocalDict_Dictionaries">Dictionaries</sys:String>
    <sys:String x:Key="STranslate_Plugin_Translate_LocalDict_DictionariesDesc">Enabled MDX dictionaries are searched in list order; a .mdd with the same name in the same folder is used for pronunciation</sys:String>
    <sys:String x:Key="STranslate_Plugin_Translate_LocalDict_Add">Add MDX dictionary</sys:String>
    <sys:String x:Key="STranslate_Plugin_Translate_LocalDict_Empty">No dictionary yet. Click the button above and pick a .mdx file (the file is not copied or modified).</sys:String>
    <sys:String x:Key="STranslate_Plugin_Translate_LocalDict_On">On</sys:String>
    <sys:String x:Key="STranslate_Plugin_Translate_LocalDict_Off">Off</sys:String>
    <sys:String x:Key="STranslate_Plugin_Translate_LocalDict_Enabled">Enabled</sys:String>
    <sys:String x:Key="STranslate_Plugin_Translate_LocalDict_MoveUp">Move up</sys:String>
    <sys:String x:Key="STranslate_Plugin_Translate_LocalDict_MoveDown">Move down</sys:String>
    <sys:String x:Key="STranslate_Plugin_Translate_LocalDict_Remove">Remove from list (file is kept)</sys:String>
    <sys:String x:Key="STranslate_Plugin_Translate_LocalDict_ShowEnglish">Show English definitions</sys:String>
    <sys:String x:Key="STranslate_Plugin_Translate_LocalDict_ShowEnglishDesc">For bilingual dictionaries, append the English definition after the Chinese one</sys:String>
    <sys:String x:Key="STranslate_Plugin_Translate_LocalDict_ShowPhrasalVerbs">Show phrasal verb list</sys:String>
    <sys:String x:Key="STranslate_Plugin_Translate_LocalDict_MaxExamples">Examples</sys:String>
    <sys:String x:Key="STranslate_Plugin_Translate_LocalDict_MaxExamplesDesc">Maximum number of example sentences per lookup (one per sense first)</sys:String>
    <sys:String x:Key="STranslate_Plugin_Translate_LocalDict_About">About</sys:String>
    <sys:String x:Key="STranslate_Plugin_Translate_LocalDict_AboutContent">Entries are read locally, nothing goes online. Inflected words are reduced to their base form (running → run) and phrasal verbs (look up) are found inside the verb entry. The speaker button plays audio from the .mdd through a loopback-only 127.0.0.1 port.</sys:String>
    <sys:String x:Key="STranslate_Plugin_Translate_LocalDict_NoDictionary">No dictionary added yet: add an MDX file in this plugin's settings</sys:String>
    <sys:String x:Key="STranslate_Plugin_Translate_LocalDict_PhrasalVerbs">Phrasal verbs</sys:String>
    <sys:String x:Key="STranslate_Plugin_Translate_LocalDict_Loading">Loading…</sys:String>
    <sys:String x:Key="STranslate_Plugin_Translate_LocalDict_EntryCount">{0:N0} entries</sys:String>
    <sys:String x:Key="STranslate_Plugin_Translate_LocalDict_WithAudio">{0:N0} audio resources</sys:String>
    <sys:String x:Key="STranslate_Plugin_Translate_LocalDict_NoAudio">No matching .mdd found, pronunciation unavailable</sys:String>
    <sys:String x:Key="STranslate_Plugin_Translate_LocalDict_Duplicate">already in the list</sys:String>
    <sys:String x:Key="STranslate_Plugin_Translate_LocalDict_SelectDictionary">Select MDX dictionary</sys:String>

</ResourceDictionary>
