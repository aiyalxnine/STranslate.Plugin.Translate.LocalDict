<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>preview</LangVersion>
    <STranslateHome Condition="'$(STranslateHome)' == ''">$(LOCALAPPDATA)\STranslate\current</STranslateHome>
  </PropertyGroup>
  <ItemGroup>
    <Using Include="System.IO" />
    <Reference Include="STranslate.Plugin">
      <HintPath>$(STranslateHome)\STranslate.Plugin.dll</HintPath>
    </Reference>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.9" />
    <PackageReference Include="iNKORE.UI.WPF.Modern" Version="0.10.2.1" />
  </ItemGroup>
</Project>
